#!/usr/bin/env python3
"""Serialize top-level compiler jobs across proof workers on this workstation."""
import fcntl
import os
from pathlib import Path
import subprocess
import sys
import signal
import resource
import re
import time

root = Path(__file__).resolve().parent.parent
lock_path = root / 'tmp' / 'lean-compiler.lock'
lock_path.parent.mkdir(exist_ok=True)
lake = Path(os.environ.get('ELAN_HOME', str(Path.home() / '.elan'))) / 'bin' / 'lake'
memory_mb = int(os.environ.get('EXPANDING_CODES_LEAN_MEMORY_MB', '6144'))
if not 1024 <= memory_mb <= 8192:
    raise SystemExit('Lean memory cap must stay between 1024 and 8192 MB (user ceiling)')
with lock_path.open('w') as lock:
    arguments = list(sys.argv[1:])
    if len(arguments) >= 2 and arguments[0] == 'env' and arguments[1] == 'lean':
        arguments[2:2] = [f'-M{memory_mb}', '-j1']
    environment = dict(os.environ, LEAN_NUM_THREADS='1')
    commands = [arguments]
    if arguments and arguments[0] == 'build':
        # Build local imports in topological order, one module at a time. A
        # single `lake build A B` can otherwise launch several 6GB compilers.
        targets = arguments[1:] or ['ExpandingCodes']
        if not all(re.fullmatch(r"[A-Za-z_][A-Za-z_0-9'.]*", t) for t in targets):
            raise SystemExit('Use plain module targets with the serial memory-safe build wrapper')
        if not all((root / (t.replace('.', '/') + '.lean')).is_file() for t in targets):
            raise SystemExit('Build target has no project-local Lean source; use an explicit module')
        visited, visiting, order = set(), set(), []
        def visit(module):
            if module in visited:
                return
            if module in visiting:
                raise SystemExit('Local import cycle: ' + module)
            source = root / (module.replace('.', '/') + '.lean')
            if not source.is_file():
                return
            visiting.add(module)
            for line in source.read_text().splitlines():
                match = re.match(r'^\s*(?:public\s+)?import\s+([^\n]+)', line)
                if match:
                    for dependency in match.group(1).split('--', 1)[0].split():
                        visit(dependency)
            visiting.remove(module)
            visited.add(module)
            order.append(module)
        for target in targets:
            visit(target)
        commands = [['build', module] for module in order]
    child = None
    def stop(signum, frame):
        try:
            if child is not None:
                os.killpg(child.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        raise SystemExit(128 + signum)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    result = 0
    for command in commands:
        # Let another worker run its short check between cached module builds.
        # Every compiler invocation still holds the same exclusive lock.
        fcntl.flock(lock, fcntl.LOCK_EX)
        child = subprocess.Popen([str(lake), *command], cwd=root, env=environment,
                                 start_new_session=True)
        result = child.wait()
        child = None
        fcntl.flock(lock, fcntl.LOCK_UN)
        if result:
            break
        time.sleep(0.02)
    if os.environ.get('EXPANDING_CODES_REPORT_MEMORY') == '1':
        usage = resource.getrusage(resource.RUSAGE_CHILDREN)
        peak_mb = usage.ru_maxrss / (1024 * 1024 if sys.platform == 'darwin' else 1024)
        print(f'Lean check peak resident memory: {peak_mb:.0f} MB; cap: {memory_mb} MB', file=sys.stderr)
    raise SystemExit(result)
