      (scanRound b).Stops inp (d.toCfg (scanRound b).entry) t e ∧ Common ell h m M e.store ∧
      Represents ell m b' (PaddedGaussian.step (ops ell h) s) e.store ∧
      e.reg 62 = d.reg 62 ∧ e.roHead = d.roHead ∧ e.output = d.output := by
