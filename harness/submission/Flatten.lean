    (fieldSize d n)^2 + (3*fieldExponent d n+1) + 2*fieldSize d n +
    (2*k*fieldSize d n*d*fieldSize d n+1) +
    (k*(fieldSize d n)^3*samplerBucketCount k n+1) + rowCount d n + n +
    rowCount d n*n + k*samplerBucketCount k n +
