    (run A).2.inverses + (run A).2.arithmetic ≤ 12*m*n*min m n := by
  have h := run_work_le A
  unfold Work.total at h
  omega

theorem run_array_operations_le {m n : ℕ} (A : Table F m n) :
    (run A).2.reads + (run A).2.writes + (run A).2.enumerated ≤
