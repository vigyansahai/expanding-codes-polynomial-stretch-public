    (TapeArrays.initializeBuffer (R := 80+6*d) (0 : Fin 3))
    (TapeArrays.initializeBuffer (1 : Fin 3))) (TapeArrays.initializeBuffer (2 : Fin 3)))
    (TapeMacros.copy (low d 70) (low d 76) (low d 2)))
    (TesterInput.load (inputLayout d) (2 : Fin 3))

