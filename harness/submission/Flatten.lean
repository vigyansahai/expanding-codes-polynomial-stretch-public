    {c d : TapeCfg S C L} {t : ℕ} (h : (P.renameStorage ρ σ).Exec inp c t d)
    (r : Fin S) (hr : ∀ i, r ≠ ρ i) : d.reg r = c.reg r :=
  h.reg_of_fresh (renameStorage_fresh ρ σ P r hr)

