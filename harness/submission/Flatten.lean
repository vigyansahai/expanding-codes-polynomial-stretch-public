      if address g s c.1 z = c.2 then 1 else 0 := by
  rw [preliminaryColumnPolynomial, ExpandingCodes.eval_flatIndicator]
  have hpred :
      (∀ i : Fin 3, MvPolynomial.eval z (preliminaryColumnForms g s c.1 c.2.1 i) =
