def sumValue (values : Fin R → ℕ) (ps : List (Fin R)) : ℕ := (ps.map values).sum

theorem sumCore_stops (dst tmp : Fin R) (hdt : dst≠tmp) (ps : List (Fin R))
    (hp : ∀ p∈ps,p≠dst ∧ p≠tmp) (inp : Inputs) (M : ℕ) (s : TapeStore R B)
