  refine ⟨final,he,hproj,hout,?_⟩
  intro r
  by_cases hr : ∃ i, ρ i = r
  · obtain ⟨i,hi⟩ := hr
    have hv : final.reg (ρ i) = d.reg i := congrArg (fun c : TapeCfg R B L => c.reg i) hproj
    rw [← hi,hv]
