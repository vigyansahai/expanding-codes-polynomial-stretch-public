structure CoordinateOutcome (d e : Store) (M : ℕ) : Prop where
  col : e.reg 43 = d.reg 2 % d.reg 40
  rowBase : e.reg 44 = d.reg 2 / d.reg 40 * d.reg 40
  frame : ∀ r, OutsidePivotCoordinates r → e.reg r = d.reg r
  bounded : ∀ r, e.reg r ≤ M
