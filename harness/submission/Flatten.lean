      _ ≤ (Real.exp (s*(a-uniformMean f)) * Real.exp ((m : ℝ)*s^2/8) +
            Real.exp (s*(b-uniformMean f)) * Real.exp ((m : ℝ)*s^2/8)) / 2 := by
        exact div_le_div_of_nonneg_right
