    (outerBodyStore r d).reg (r i) = d.reg (r i) := by
  unfold outerBodyStore
  simp only [reg_set r hr,if_neg h0]
  rw [innerResult_frame r hr _ _ i hi h1 h25 h30,innerPrepareStore_reg r hr]
