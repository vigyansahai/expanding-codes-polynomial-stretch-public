  unfold cost
  cases P.code c.pc <;> simp

 theorem time_le (P : TapeProgram R B L) (inp : Inputs) (t : ℕ) :
    P.time inp t ≤ 2*t := by
  induction t with
  | zero => simp [time]
  | succ t ih =>
    have hc := P.cost_le_two (P.run inp t)
    simp only [time]
