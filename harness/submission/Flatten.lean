  have he := outerBodyStore_index r hr d
  have he' : (innerResult r (d.reg (r 24)) (innerPrepareStore r d)).reg (r 0)+1 = d.reg (r 0)+1 := by
    simpa only [outerBodyStore,TapeStore.setReg,Function.update_self] using he
  rw [he'];exact hc

