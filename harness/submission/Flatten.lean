    _ = uniformProb (fun x : Fin (rowCount d n) → Bool =>
        rankTest ε g (boolWord x) = true) := by
      symm
      simpa only [boolWordEquiv_apply] using uniformProb_equiv (boolWordEquiv (rowCount d n))
