            (Nat.centralBinom s ^ 2 * (2 * s + 1)) := by nlinarith [he]
        _ ≤ 4 * (2 * s + 1) * (2 * s + 3) * 16 ^ s := by nlinarith [hb]
        _ ≤ 16 * (s + 1) ^ 2 * 16 ^ s := hb'
        _ = _ := by rw [pow_succ]; ring
    exact (mul_le_mul_iff_left₀ (by positivity : 0 < (s + 1) ^ 2)).mp hh

