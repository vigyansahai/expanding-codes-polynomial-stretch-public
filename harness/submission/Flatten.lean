    nlinarith [mul_nonneg (show 0 ≤ 1-(a-b) by linarith)
      (show 0 ≤ 1+(a-b) by linarith)]
  nlinarith [mul_nonneg (sq_nonneg s) (show 0 ≤ 1-(a-b)^2 by linarith)]

