  ∀ a b : Fin (2^ell), 1 < a.val → 1 < b.val → ¬ FactorMatches ell p a b

instance (ell : ℕ) (p : Fin (2^ell)) : Decidable (FactorFree ell p) := by
  unfold FactorFree
  infer_instance

