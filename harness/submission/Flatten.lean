    nlinarith [Real.sq_sqrt (show 0 ≤ 2 * (s : ℝ) + 1 by positivity),
      show 0 ≤ (Nat.centralBinom s : ℝ) by positivity,
      show 0 < (4 : ℝ) ^ s by positivity]
