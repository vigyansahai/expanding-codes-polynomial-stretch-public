theorem collision_core_activePairs_nonempty {d n k : ℕ} (g : Geometry d n)
    (hd : 0 < d) (s : Forms g.F d k) (S : Finset (Fin (rowCount d n)))
    (hne : S.Nonempty) (hcore : ∀ z ∈ S, d ≤
      (collisionLayers (fun z i => address g s i (g.rowOrder z)) S z).card) :
