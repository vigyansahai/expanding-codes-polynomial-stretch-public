theorem eventual_rankTest_uniform_acceptance_family (ε : ℝ)
    (hε : 0 < ε ∧ ε < 1/2) (g : ∀ n, Geometry (dimension ε) n) :
    ∀ᶠ n : ℕ in atTop,
