theorem poly_one (ell : ℕ) (a : Fin (2^ell)) (ha : a.val = 1) : poly ell a = 1 := by
  ext j
  rw [poly_coeff,ha]
  cases j <;> simp [Polynomial.coeff_one,Nat.testBit_succ,bitEquiv_false,bitEquiv_true]

