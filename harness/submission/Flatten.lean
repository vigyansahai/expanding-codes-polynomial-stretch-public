theorem innerResult_bound (r : Fin 27 → Fin R) (hr : Function.Injective r)
    (M : ℕ) (hM : 1 ≤ M) (n : ℕ) (d : TapeStore R B) (hd : ∀ j, d.reg j ≤ M)
