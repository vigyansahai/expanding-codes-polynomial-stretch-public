  let aInv := O.inv (B p.1 p.2)
  ofMatrix fun i j =>
    O.sub (B (p.1.succAbove i) (p.2.succAbove j))
      (O.mul (O.mul (B (p.1.succAbove i) p.2) aInv)
        (B p.1 (p.2.succAbove j)))

