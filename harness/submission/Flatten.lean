theorem Exec.liftStorage {P : TapeProgram R B L} {inp : Inputs}
    {c d : TapeCfg R B L} {t : ℕ} (h : P.Exec inp c t d)
    (ρ : Fin R → Fin S) (σ : Fin B → Fin C)
