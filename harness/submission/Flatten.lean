  obtain ⟨t₂,f,ht₂,hfs,hfo,hInput,hOutput,h41,h45,h46,hff,hro,hout⟩ := materializeGrid_stops
    (inputBuffer b) (outputBuffer b) (buffers_ne b) ell h inp s.table p
