def raise (r : Fin R) : (c : ℕ) → TapeProgram R B (raiseLabels c)
  | 0 => { entry := ⟨0, by simp [raiseLabels]⟩, code := fun _ => .halt }
  | c+1 => TapeProgram.seq (TapeMacros.increment r) (raise r c)

