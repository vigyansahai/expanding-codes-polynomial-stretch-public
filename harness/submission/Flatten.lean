theorem candidateBodyStore_fresh (r : Fin 32 → Fin R) (hr : Function.Injective r) (d : TapeStore R B)
    (i : Fin 32) (hi : i = 19 ∨ i = 23 ∨ i = 24 ∨ i = 31) :
