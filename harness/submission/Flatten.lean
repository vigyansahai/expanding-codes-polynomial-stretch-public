    simp only [Fin.forall_fin_succ, Fin.forall_fin_zero, preliminaryColumnForms,
      Matrix.cons_val_zero, Matrix.cons_val_succ, ExpandingCodes.eval_affinePolynomial,
      zero_add, and_true]
