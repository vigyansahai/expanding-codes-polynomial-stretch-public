end Mean

/-- A change to one Boolean coordinate changes the value by at most one. -/
def HasUnitBoundedDifferences {m : ℕ} (f : (Fin m → Bool) → ℝ) : Prop :=
  ∀ x i b, |f (Function.update x i b) - f x| ≤ 1

