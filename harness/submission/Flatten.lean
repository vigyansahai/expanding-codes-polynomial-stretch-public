      ∑ j ∈ s, w j * a j ^ (3 / 2 : ℝ) :=
    Finset.sum_congr rfl (fun j hj => hpow j hj (a j) (ha j hj))
  have hb' : (∑ j ∈ s, (w j ^ (2 / 3 : ℝ) * b j) ^ (3 / 2 : ℝ)) =
      ∑ j ∈ s, w j * b j ^ (3 / 2 : ℝ) :=
    Finset.sum_congr rfl (fun j hj => hpow j hj (b j) (hb j hj))
