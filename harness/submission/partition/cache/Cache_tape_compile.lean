open NKtLB

private theorem cache_type_witness_tape_compile {R B L : ℕ} (P : ExpandingCodes.Computation.TapeProgram R B L) (O : Set (List Bool)) (inp : Inputs)
    (t : ℕ) (hh : P.halted (P.run inp t)) :
    (ExpandingCodes.Computation.TapeCompiler.compile P).HaltsWith O inp (1+2*t) (bitsSym (P.run inp t).output) := by
  exact @ExpandingCodes.Computation.TapeCompiler.compile_halts R B L P O inp t hh


open Lean Elab Command
run_meta do
  let env ← getEnv
  let some target := env.find? `ExpandingCodes.Computation.TapeCompiler.compile_halts | throwError "Missing cache target"
  let candidates := env.constants.toList.filterMap fun (n, ci) =>
    if privateToUserName? n == some `cache_type_witness_tape_compile then some ci else none
  unless candidates.length == 1 do throwError "Missing unique cache type witness"
  unless ← Meta.isDefEq target.type candidates.head!.type do
    throwError "Cache target type differs from audited statement"
  let axes ← collectAxioms `ExpandingCodes.Computation.TapeCompiler.compile_halts
  unless axes.all (fun n => #[`propext, `Classical.choice, `Quot.sound].contains n) do
    throwError "Unexpected target axioms: {axes}"
  IO.FS.writeFile "harness/submission/partition/tape_compile-cache-audit.json" (Json.mkObj [("theorem_name",toJson "ExpandingCodes.Computation.TapeCompiler.compile_halts"),("exact_statement_type",toJson true),("axioms",toJson (axes.map Name.toString))]).pretty
  logInfo m!"Closed helper target exact type and standard axioms only: {axes}"
