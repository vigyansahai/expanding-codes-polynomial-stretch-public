 private theorem cost_le_two (P : TapeProgram R B L) (c : TapeCfg R B L) : P.cost c ≤ 2 := by
  unfold cost
  cases P.code c.pc <;> simp

 private theorem time_le (P : TapeProgram R B L) (inp : Inputs) (t : ℕ) :
    P.time inp t ≤ 2*t := by
  induction t with
  | zero => simp [time]
  | succ t ih =>
    have hc := P.cost_le_two (P.run inp t)
    simp only [time]
    omega

 private theorem run_succ (P : TapeProgram R B L) (inp : Inputs) (t : ℕ) :
    P.run inp (t+1) = P.step inp (P.run inp t) :=
  Function.iterate_succ_apply' _ _ _

 private theorem step_halted (P : TapeProgram R B L) (inp : Inputs) (c : TapeCfg R B L)
    (h : P.halted c) : P.step inp c = c := by
  change P.code c.pc = .halt at h
  simp [step, h]


