  (bufferCoefficient_eq (indexEquiv ell a) j).symm.trans (bufferCoefficient_bit ell a j)

private theorem poly_zero (ell : ℕ) (a : Fin (2^ell)) (ha : a.val = 0) : poly ell a = 0 := by
  ext j
  simp [poly_coeff,ha,bitEquiv_false]

private theorem poly_one (ell : ℕ) (a : Fin (2^ell)) (ha : a.val = 1) : poly ell a = 1 := by
  ext j
  rw [poly_coeff,ha]
  cases j <;> simp [Polynomial.coeff_one,Nat.testBit_succ,bitEquiv_false,bitEquiv_true]

private theorem val_one_of_poly_one (ell : ℕ) (a : Fin (2^ell)) (ha : poly ell a = 1) : a.val = 1 := by
  apply Nat.eq_of_testBit_eq
  intro j
