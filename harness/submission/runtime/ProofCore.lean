private theorem monicWord_stops (r : Fin 32 → Fin R) (hr : Function.Injective r) (inp : Inputs)
    (M : ℕ) (d : TapeStore R B) (hd : ∀ j,d.reg j ≤ M) (hsum : d.reg (r 23)+d.reg (r 27) ≤ M) :
