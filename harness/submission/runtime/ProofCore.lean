  have hp : 1 ≤ (rowCount (dimension (θ : ℝ)) n + n + 1) ^ b :=
    one_le_pow₀ (by omega)
  have htime : 1+2*t ≤ (2*C+1) * (rowCount (dimension (θ : ℝ)) n + n + 1) ^ b := by
    nlinarith
  have hm := (TapeCompiler.compile_computes P (sizeInput n ++ wordBits y) t hh).mono htime
  simpa only [hout] using hm

