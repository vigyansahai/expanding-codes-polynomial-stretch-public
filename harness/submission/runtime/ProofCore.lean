        Function.update_of_ne hpc, Function.update_of_ne hsc]
      nlinarith
    · exact TapeProgram.loop_code_exit (halfStep src quotient parity) count

private theorem setReg_bound (d : TapeStore R B) (r : Fin R) (n M : ℕ)
