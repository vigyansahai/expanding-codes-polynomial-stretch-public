private theorem testerImplementation_of_tape {R B L : ℕ}
    (θ : ℚ) (g : ∀ n, Geometry (dimension (θ : ℝ)) n)
    (P : TapeProgram R B L) (C b N : ℕ) (hN : 2 ≤ N)
