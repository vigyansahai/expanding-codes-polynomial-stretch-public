  · intro h
    have ha := natDegree_polynomial_lt hell (indexEquiv ell a)
    have hb := natDegree_polynomial_lt hell (indexEquiv ell b)
    have hl : (poly ell a * poly ell b).natDegree ≤ 3*ell :=
