    simp_all [hashLayout,hr.eq_iff]




















private theorem hashIndexStore_value (r : Fin 8 → Fin R) (hr : Function.Injective r)
    (i : ℕ) (s : TapeStore R B) :
    (hashIndexStore r i s).reg (r 4)=s.reg (r 3)+s.reg (r 0)*
      (s.reg (r 2)+s.reg (r 0)*(s.reg (r 1)+s.reg (r 0)*i)) := by
