    TapeArrays.ThermometerTable (formFillStore r hr d k b inp s) b (s.reg (r 35))
      (fun i => (RandomTables.sampledValues inp (2*k*s.reg (r 35)*d) (s.reg (r 34)) (s.roHead 3) i).val) := by
