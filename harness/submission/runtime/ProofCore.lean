private theorem fetchPost_frame (d : Store) (address dest : Fin 64) (v : ℕ) (r : Fin 64)
    (hr : r = 0 ∨ 9 ≤ r.val) (hne : r ≠ dest) :
    (fetchPost d address dest v).reg r = d.reg r := by
