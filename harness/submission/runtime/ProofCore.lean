  | inl a =>
    intro heq
    have h := congrArg Fin.val heq
    change j.val=(writerIndex a).val at h
    fin_cases a <;> simp [writerIndex] at h <;> first | exact h32 (Fin.ext h) | omega
  | inr a =>
    intro heq
    have h := congrArg Fin.val heq
    change j.val=80+4*d+a.val at h
