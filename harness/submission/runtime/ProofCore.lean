    (Gaussian.toMatrix (EncodedGaussian.mapTable decode A)).rank =
      (Gaussian.toMatrix (EncodedGaussian.mapTable decode (paddedSchur O A p))).rank+1 := by
  rw [paddedSchur_rank h A p hp]
  exact encoded_schur_rank_step h A p hp



