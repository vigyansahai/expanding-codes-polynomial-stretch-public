private theorem const (C : ℕ) : PolynomialMajorant (fun _ => C) := ⟨C,0,by simp⟩
private theorem id : PolynomialMajorant (fun n => n) := ⟨1,1,by intro n; simp⟩






private theorem add {f g : ℕ → ℕ} (hf : PolynomialMajorant f) (hg : PolynomialMajorant g) :
    PolynomialMajorant (fun n => f n+g n) := by
  obtain ⟨C,a,hf⟩ := hf
  obtain ⟨D,b,hg⟩ := hg
  refine ⟨C+D,a+b,?_⟩
  intro n
  have hpa : (n+1)^a≤(n+1)^(a+b) := Nat.pow_le_pow_right (by omega) (by omega)
  have hpb : (n+1)^b≤(n+1)^(a+b) := Nat.pow_le_pow_right (by omega) (by omega)
  calc
    f n+g n≤C*(n+1)^a+D*(n+1)^b := Nat.add_le_add (hf n) (hg n)
    _≤C*(n+1)^(a+b)+D*(n+1)^(a+b) :=
      Nat.add_le_add (Nat.mul_le_mul_left C hpa) (Nat.mul_le_mul_left D hpb)
    _=(C+D)*(n+1)^(a+b) := by ring

private theorem mul {f g : ℕ → ℕ} (hf : PolynomialMajorant f) (hg : PolynomialMajorant g) :
    PolynomialMajorant (fun n => f n*g n) := by
  obtain ⟨C,a,hf⟩ := hf
  obtain ⟨D,b,hg⟩ := hg
  refine ⟨C*D,a+b,?_⟩
  intro n
  calc
    f n*g n≤(C*(n+1)^a)*(D*(n+1)^b) := Nat.mul_le_mul (hf n) (hg n)
    _=(C*D)*(n+1)^(a+b) := by rw [pow_add]; ring

private theorem pow {f : ℕ → ℕ} (hf : PolynomialMajorant f) (e : ℕ) :
    PolynomialMajorant (fun n => (f n)^e) := by
  obtain ⟨C,a,hf⟩ := hf
  refine ⟨C^e,a*e,?_⟩
  intro n
  calc
    (f n)^e≤(C*(n+1)^a)^e := Nat.pow_le_pow_left (hf n) e
    _=C^e*(n+1)^(a*e) := by rw [mul_pow,pow_mul]

private theorem comp {f g : ℕ → ℕ} (hf : PolynomialMajorant f) (hg : PolynomialMajorant g) :
    PolynomialMajorant (fun n => f (g n)) := by
  obtain ⟨C,a,hf⟩ := hf
  obtain ⟨D,b,hg⟩ := (hg.add (const 1)).pow a
  refine ⟨C*D,b,?_⟩
  intro n
  calc
    f (g n)≤C*(g n+1)^a := hf _
    _≤C*(D*(n+1)^b) := Nat.mul_le_mul_left C (hg n)
    _=(C*D)*(n+1)^b := by ring

