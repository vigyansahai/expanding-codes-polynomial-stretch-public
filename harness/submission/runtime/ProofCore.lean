private theorem writeRow_low (d k : ℕ) (s : TapeStore (Storage.registers d k) 2)
    (j : Fin 80) (hj : j.val<40) :
    (NeighborWriter.writeRowStore (writerLayout d k) s).reg (Storage.low d k j)=s.reg (Storage.low d k j) := by
  by_cases h32 : j=32
