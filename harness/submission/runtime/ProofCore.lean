    HasDerivAt (fun q => probability q Ω) (totalInfluence p Ω) p := by
  simpa only [expectationOn_univ, probability, totalInfluence, influence] using
    hasDerivAt_expectationOn (Finset.univ : Finset I) (indicator Ω) p

