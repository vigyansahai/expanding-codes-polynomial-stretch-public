  obtain ⟨t₅,c₅,ht₅,h₅,hv₅,he₅,hf₅,hb₅,hd₅⟩ := SamplerProgram.term_stops (termWorkspace d)
    (SamplerProgram.powerWorkspace_injective _ (TesterPowers.scalar_injective _ hr)) (low d 68) (low d 64)
