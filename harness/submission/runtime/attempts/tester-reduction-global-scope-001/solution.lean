theorem add {f g : ℕ → ℕ} (hf : PolynomialMajorant f) (hg : PolynomialMajorant g) :
    PolynomialMajorant (fun n => f n+g n) := by
  obtain ⟨C,a,hf⟩ := hf
  obtain ⟨D,b,hg⟩ := hg
