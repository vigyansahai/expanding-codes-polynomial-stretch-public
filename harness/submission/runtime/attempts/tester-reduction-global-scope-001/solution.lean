    f n+g n≤C*(n+1)^a+D*(n+1)^b := Nat.add_le_add (hf n) (hg n)
    _≤C*(n+1)^(a+b)+D*(n+1)^(a+b) :=
      Nat.add_le_add (Nat.mul_le_mul_left C hpa) (Nat.mul_le_mul_left D hpb)
    _=(C+D)*(n+1)^(a+b) := by ring











