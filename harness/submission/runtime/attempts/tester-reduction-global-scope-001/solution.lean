  change ((L * Matrix.fromBlocks A 0 0 (D - C * ⅟A * B)) * U).rank = _
  rw [Matrix.rank_mul_eq_left_of_isUnit_det U _ hU,
    Matrix.rank_mul_eq_right_of_isUnit_det L _ hL, rank_fromBlocks_zero]







