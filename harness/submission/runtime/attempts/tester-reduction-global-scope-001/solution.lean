    dsimp [L]
    rw [Matrix.isUnit_fromBlocks_zero₁₂]
    exact ⟨isUnit_one, isUnit_one⟩)
  have hU : IsUnit U.det := (Matrix.isUnit_iff_isUnit_det U).mp (by
    dsimp [U]
    rw [Matrix.isUnit_fromBlocks_zero₂₁]
    exact ⟨isUnit_one, isUnit_one⟩)
