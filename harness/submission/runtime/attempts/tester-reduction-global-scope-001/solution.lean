  obtain ⟨C,a,hf⟩ := hf
  obtain ⟨D,b,hg⟩ := (hg.add (const 1)).pow a
  refine ⟨C*D,b,?_⟩
  intro n
  calc
    f (g n)≤C*(g n+1)^a := hf _
    _≤C*(D*(n+1)^b) := Nat.mul_le_mul_left C (hg n)
    _=(C*D)*(n+1)^b := by ring

