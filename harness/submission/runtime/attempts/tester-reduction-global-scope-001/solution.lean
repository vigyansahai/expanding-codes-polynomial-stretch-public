  intro n
  have hpa : (n+1)^a≤(n+1)^(a+b) := Nat.pow_le_pow_right (by omega) (by omega)
  have hpb : (n+1)^b≤(n+1)^(a+b) := Nat.pow_le_pow_right (by omega) (by omega)
